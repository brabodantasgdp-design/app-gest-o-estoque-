# ============================================
# EBD ElBravoDantas - Configuração de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# ============================================

# Supabase Configuration (obrigatório para funcionamento completo)
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_ANON_KEY="SUA-CHAVE-ANON-AQUI"

# Gemini API Key (server-side - NÃO exponha esta chave no frontend)
# Usada pelo servidor Express para OCR e processamento de IA
GEMINI_API_KEY="sua-chave-gemini-aqui"

# Gemini API Key (client-side - apenas se usar geminiService.ts diretamente)
# AVISO: Esta chave fica exposta no bundle do navegador. Use apenas em desenvolvimento.
VITE_GEMINI_API_KEY="sua-chave-gemini-aqui"

# Super Admin Credentials (para fallback auth quando Supabase não está configurado)
SUPABASE_ADMIN_EMAIL="admin@seu-dominio.com"
SUPABASE_ADMIN_PASSWORD="senha-segura-aqui"

# Fallback Password (para criação de contas quando Supabase não está configurado)
FALLBACK_PASSWORD="senha-segura-aqui"

# Database (optional, for Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/retailpro"

# Server Configuration
PORT=3000
NODE_ENV=development