# EBD ElBravoDantas - Environment Variables Setup

# Gemini AI API Key (Required for server-side OCR and AI assistant features)
# Get your key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase + PostgreSQL Prisma Database Connections
# Get these in Supabase Dashboard -> Project Settings -> Database -> Connection String
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgboiler=true&pkey=direct"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Supabase Auth Credentials
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# Optional: Port configuration for Cloud Run / Container deployments
PORT=3000
NODE_ENV=development
